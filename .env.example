# Get a free key at https://openrouter.ai/keys
# Copy this file to .env and paste your key after the = sign.
OPENROUTER_API_KEY=sk-or-your-key-here

# Day2 Langsmith .env - US region (default)
# LangSmith is LLMOPS tool used for debugging and monitoring LLMs, standard debugging is straightforward since code is deterministic but for multiple LLM calls, tool based execution, debugging if output is incorrect is challenging.
LANGCHAIN_TRACING_V2=true # Tell langchain client to send traces 
LANGSMITH_ENDPOINT=https://api.smith.langchain.com # GCP US Region endpoint, check https://docs.langchain.com/langsmith/hybrid
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=langchain-10-days-bootcamp

# Day 7 web search tool. Get a free key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-key-here
